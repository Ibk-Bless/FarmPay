# Server
PORT=4000

# Stellar network (defaults to testnet)
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Deployed FarmPay escrow contract (see docs/GETTING_STARTED.md)
ESCROW_CONTRACT_ID=

# Browser origins allowed to call the API, comma-separated. Leave empty in development;
# set it when deploying, e.g. https://farmpay.example
CORS_ORIGIN=

# One JSON log line per request (set to false to silence)
LOG_REQUESTS=true

# The order index: a local copy of every order, used by GET /api/orders?party=.
# It is a cache. Delete it and it is rebuilt from the chain.
# INDEX_DB_PATH=./data/index.sqlite
# INDEX_POLL_MS=5000
# On the very first run, replay events from this ledger instead of starting at the latest one
# (normally unnecessary: existing orders are found by reading them directly)
# INDEX_START_LEDGER=
